{
  "name": "sql-notebook-kit-vscode",
  "displayName": "SQL Notebook Kit Visualizations",
  "description": "Metadata, theme, and saved-visualization companion for SQL Notebook Kit notebooks.",
  "version": "0.1.0",
  "publisher": "sql-notebook-kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesar-alves/sql-notebook-kit.git"
  },
  "bugs": {
    "url": "https://github.com/cesar-alves/sql-notebook-kit/issues"
  },
  "homepage": "https://cesar-alves.github.io/sql-notebook-kit/",
  "categories": ["Visualization", "Notebooks"],
  "keywords": ["sql", "jupyter", "notebook", "duckdb", "visualization"],
  "files": ["dist", "syntaxes", "LICENSE"],
  "engines": { "vscode": "^1.100.0" },
  "extensionKind": ["workspace"],
  "extensionDependencies": ["ms-toolsai.jupyter"],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onRenderer:sql-notebook-kit-bridge",
    "onRenderer:sql-notebook-kit-widget-fallback"
  ],
  "contributes": {
    "notebookRenderer": [
      {
        "id": "sql-notebook-kit-bridge",
        "displayName": "SQL Notebook Kit Visualization Bridge",
        "entrypoint": "./dist/renderer.js",
        "mimeTypes": [
          "application/vnd.sql-notebook-kit.bridge+json",
          "application/vnd.code.notebook.error"
        ],
        "requiresMessaging": "always"
      },
      {
        "id": "sql-notebook-kit-widget-fallback",
        "displayName": "SQL Notebook Kit Saved Visualization Fallback",
        "entrypoint": {
          "extends": "jupyter-ipywidget-renderer",
          "path": "./dist/widgetFallback.js"
        },
        "requiresMessaging": "always"
      }
    ],
    "grammars": [{
      "scopeName": "sql-notebook-kit.sql-magic",
      "path": "./syntaxes/sql-notebook-kit-sql-magic.tmLanguage.json",
      "injectTo": ["source.python"]
    }]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.cjs && esbuild src/renderer.ts --bundle --platform=browser --format=esm --outfile=dist/renderer.js && esbuild src/widgetFallback.ts --bundle --platform=browser --format=esm --outfile=dist/widgetFallback.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @sql-notebook-kit/protocol build",
    "test": "pnpm build && vitest run",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": { "@sql-notebook-kit/protocol": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@types/vscode-notebook-renderer": "^1.72.4",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^20.0.3"
  }
}
