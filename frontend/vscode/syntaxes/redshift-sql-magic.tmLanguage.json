{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Redshift SQL magics",
  "scopeName": "redshift-notebooks.sql-magic",
  "injectionSelector": "L:source.python",
  "patterns": [
    {
      "begin": "^(\\s*)(%%sql)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "keyword.control.magic.sql" } },
      "end": "\\z",
      "contentName": "meta.embedded.block.sql",
      "patterns": [{ "include": "#redshift" }, { "include": "source.sql" }]
    },
    {
      "begin": "^(\\s*)(%sql)\\s*$",
      "beginCaptures": { "2": { "name": "keyword.control.magic.sql" } },
      "end": "\\z",
      "contentName": "meta.embedded.block.sql",
      "patterns": [{ "include": "#redshift" }, { "include": "source.sql" }]
    },
    {
      "begin": "^(\\s*)(%sql)(?=\\s+)",
      "beginCaptures": { "2": { "name": "keyword.control.magic.sql" } },
      "end": "$",
      "contentName": "meta.embedded.inline.sql",
      "patterns": [{ "include": "#redshift" }, { "include": "source.sql" }]
    }
  ],
  "repository": {
    "redshift": {
      "patterns": [
        {
          "match": "(?i)\\b(AZ64|BYTEDICT|COPY|DEEP|DISTKEY|DISTSTYLE|ENCODE|INTERLEAVED|QUALIFY|SORTKEY|SUPER|UNLOAD|VACUUM|VARBYTE)\\b",
          "name": "keyword.other.redshift.sql"
        },
        {
          "match": "(?i)\\b(DATEADD|DATEDIFF|DECODE|LISTAGG|NVL)\\b(?=\\s*\\()",
          "name": "support.function.redshift.sql"
        }
      ]
    }
  }
}
