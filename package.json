{
  "name": "sql-notebook-kit-frontends",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:artifacts": "pnpm build && pnpm build:jupyterlab && pnpm package:vscode",
    "build:jupyterlab": "uv run --group frontend jupyter labextension build frontend/jupyterlab && node frontend/jupyterlab/copy-install.mjs",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "package:vscode": "pnpm --filter sql-notebook-kit-vscode package && node frontend/vscode/stage.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<=3.4.12": "3.4.14",
      "mermaid@<11.17.0": "11.17.0",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "sanitize-html@<=2.17.4": "2.17.5"
    }
  }
}
